# ==============================================================================
# FOREVER — configuración de entorno (copia este archivo a .env y rellénalo)
# Nunca subas tu .env real al repositorio.
# ==============================================================================

# --- Battle.net (https://develop.battle.net/access/clients) --------------------
BLIZZARD_CLIENT_ID=your_blizzard_client_id_here
BLIZZARD_CLIENT_SECRET=your_blizzard_client_secret_here
BLIZZARD_LOCALE=es_ES
# Login con Battle.net (verificación de personajes). Debe estar registrada en develop.battle.net.
# BATTLENET_REDIRECT_URI=http://localhost:3000/api/v1/auth/battlenet/callback

# --- FOREVER Core API -----------------------------------------------------------
PORT=3001
NODE_ENV=development
# Origen público de la web (comprobación CSRF y retornos OAuth)
WEB_ORIGIN=http://localhost:3000
# Obligatorio en producción: genera uno con  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change_this_to_a_secure_random_string
# La API escucha solo en 127.0.0.1 y confía en X-Forwarded-For del proxy (Next / cloudflared)
TRUST_PROXY=true
# DISABLE_SCHEDULER=true
# MEDIA_CACHE_DIR=./.data/media-cache

# --- Base de datos ----------------------------------------------------------------
# Desarrollo: PGlite embebido (PostgreSQL real en WASM, sin instalar nada). Ruta relativa a apps/api.
DATABASE_URL=pglite:./.data/forever
# Producción: DATABASE_URL=postgres://forever:<password>@127.0.0.1:5432/forever

# --- Web ----------------------------------------------------------------------------
# URL interna de la API para los Server Components (por defecto http://127.0.0.1:3001)
# API_INTERNAL_URL=http://127.0.0.1:3001

# --- Herramientas -------------------------------------------------------------------
# Sonda de validación (npm run probe:api)
WOW_FOREVER_GUILD_SLUG=c-a-ñ-a-d-a
WOW_FOREVER_TEST_CHARACTER=el-peregrino
# Carpeta del cliente para la futura app compañera (SavedVariables / WoWCombatLog)
WOW_CLIENT_DIR=C:\Program Files (x86)\World of Warcraft\_forever_
